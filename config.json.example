{
  "io": {
    "inputPath": "./in.jar",
    "outputPath": "./out.jar",
    "dependenciesPath": "./libs"
  },
  "exclusions": [],
  "packer": {
    "enable": false,
    "mainClassName": "",
    "bootstrapClassName": ""
  },
  "constants": {
    "enable": false,
    "constantArray": false,
    "splitStrings": false,
    "strings": false,
    "numbers": false
  },
  "flow": {
    "controlFlow": {
      "enable": true,
      "minDispatcherChainLength": 1,
      "maxDispatcherChainLength": 3
    },
    "dataFlow": false
  },
  "references": {
    "encryption": {
      "enable": false,
      "methodCalls": false,
      "fieldAccess": false
    },
    "proxy": {
      "enable": false,
      "minDepth": 1,
      "maxDepth": 3
    }
  }
}