{
  "io": {
    "inputPath": "./wd/in.jar",
    "outputPath": "./wd/out.jar",
    "dependenciesPath": "./wd/libs"
  },
  "exclusions": [],
  "entryPoints": {
    "fromManifest": false,
    "custom": {}
  },
  "rename": false,
  "salt": false,
  "classInitOrder": [
    [
      "class/initializedFirst/name",
      "class/initializedAfter/name"
    ],
    [
      "class/initializedFirst/name",
      "otherClass/initializedAfter/name"
    ]
  ],
  "constants": {
    "enable": false,
    "strings": false,
    "numbers": false
  },
  "mba": {
    "enable": false,
    "minPasses": 1,
    "maxPasses": 1
  },
  "flow": {
    "controlFlow": {
      "enable": false,
      "replaceGotos": false,
      "minDispatcherChainLength": 1,
      "maxDispatcherChainLength": 1
    },
    "dataFlow": false
  },
  "referenceEncryption": {
    "enable": false,
    "firstClassOnly": false
  }
}