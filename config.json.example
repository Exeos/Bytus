{
  "io": {
    "inputPath": "./in.jar",
    "outputPath": "./out.jar"
  },
  "exclusions": [],
  "packer": {
    "enable": false,
    "mainClassName": "",
    "bootstrapClassName": ""
  },
  "constants": {
    "enable": false,
    "strings": false,
    "numbers": false
  },
  "flow": {
    "controlFlow": {
      "enable": true,
      "minDispatcherChainLength": 1,
      "maxDispatcherChainLength": 3
    },
    "dataFlow": true
  },
  "references": {
    "enable": false,
    "methodCall": true,
    "fieldAccess": false
  }
}