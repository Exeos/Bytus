{
  "io": {
    "inputPath": "./in.jar",
    "outputPath": "./out.jar"
  },
  "exclusions": [],
  "packer": {
    "enable": false,
    "mainClassName": "",
    "bootstrapClassName": ""
  },
  "constants": {
    "enable": false,
    "strings": false,
    "numbers": false
  },
  "flow": {
    "enable": true,
    "minDispatcherChainLength": 1,
    "maxDispatcherChainLength": 3
  }
}